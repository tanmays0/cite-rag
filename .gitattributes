# GitHub Linguist — multi-language bar for the real stack
pnpm-lock.yaml linguist-generated=true
package-lock.json linguist-generated=true
yarn.lock linguist-generated=true

# Include prose / ops languages in the public language bar
*.md linguist-detectable=true
*.sql linguist-detectable=true
Dockerfile linguist-detectable=true
docker-compose.yml linguist-detectable=true
*.mjs linguist-detectable=true

# Tiny sample corpus texts — not product code
data/fixtures/** linguist-documentation=true
